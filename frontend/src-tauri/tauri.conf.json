{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS2 Ultimate Insight Studio",
  "version": "2.4.2",
  "identifier": "com.cs2insightagent.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CS2 Ultimate Insight Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "league-mini",
        "title": "Insight · League Mini",
        "url": "mini.html",
        "width": 340,
        "height": 480,
        "minWidth": 300,
        "minHeight": 380,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../../packaging/windows/app-icon.ico"],
    "resources": {
      "bundle-resources/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../../packaging/windows/app-icon.ico",
        "installerHooks": "windows/upgrade-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMjcwNkFBNUIwNEJGNDgKUldSSXZ3UmJxZ1luT25TSzY2Y2M3WGhDWlpVQWVScWdKbWhqOFlGL0p5QktEVEFScERlRVRmYWIK",
      "endpoints": [
        "https://raw.githubusercontent.com/INEEDBUG/CS2-Ultimate-Insight-Studio-Private/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
